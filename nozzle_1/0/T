FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField uniform 1800;

boundaryField
{
    inlet
    {
    	type 		fixedValue;
	value uniform	1800;
    }
    outletRight
    {
    	type 		zeroGradient;
    }
    outletTop
    {
    	type 		zeroGradient;
    }
    outletLeft
    {
    	type 		fixedValue;
	value uniform	1800;
    }
    wall
    {
    	type		zeroGradient;
    }
    front
    {
    	type		wedge;
    }
    back
    {
    	type		wedge;
    }
}


